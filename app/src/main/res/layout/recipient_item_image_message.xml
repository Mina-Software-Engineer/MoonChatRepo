<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>
        <variable
            name="message"
            type="com.mina.moonchat.models.TextMessage" />
    </data>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="7dp">

        <LinearLayout
            android:id="@+id/layout_bubble"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/recipient_item_background"
            android:orientation="vertical"
            android:padding="6dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintWidth_percent="0.78">

            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/image_view_rec_message_image"
                android:layout_width="256dp"
                android:layout_height="200dp"
                android:contentDescription="@string/chat_image_description"
                android:scaleType="centerCrop"
                android:src="@drawable/ic_image_message"
                app:shapeAppearanceOverlay="@style/RecipientMessageImageView"
                tools:ignore="ImageContrastCheck" />

            <TextView
                android:id="@+id/text_view_rec_message_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end"
                android:paddingTop="4dp"
                android:textColor="#6B7280"
                android:textSize="11sp"
                app:timeTextConvert="@{message.date}"
                tools:text="12:12 AM" />
        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>
