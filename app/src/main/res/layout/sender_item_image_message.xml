<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>
        <variable
            name="message"
            type="com.mina.moonchat.models.TextMessage" />
    </data>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="7dp">

        <LinearLayout
            android:id="@+id/layout_bubble"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/send_message_background"
            android:orientation="vertical"
            android:padding="6dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintWidth_percent="0.78">

            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/image_view_message_image"
                android:layout_width="256dp"
                android:layout_height="200dp"
                android:contentDescription="@string/chat_image_description"
                android:scaleType="centerCrop"
                android:src="@drawable/ic_image_message"
                app:shapeAppearanceOverlay="@style/SenderMessageImageView"
                tools:ignore="ImageContrastCheck" />

            <LinearLayout
                android:id="@+id/layout_time_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical|end"
                android:orientation="horizontal"
                android:paddingTop="4dp">

                <TextView
                    android:id="@+id/text_view_time"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/gray"
                    android:textSize="11sp"
                    app:timeTextConvert="@{message.date}"
                    tools:text="12:12 AM" />

                <ImageView
                    android:id="@+id/image_view_status"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_marginStart="5dp"
                    android:contentDescription="@string/message_status_sent"
                    android:scaleType="centerInside"
                    tools:src="@drawable/ic_tick" />
            </LinearLayout>

            <TextView
                android:id="@+id/failed_message_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/message_failed_to_send"
                android:textColor="@color/error"
                android:textSize="11sp"
                android:visibility="gone" />

            <Button
                android:id="@+id/retry_message_button"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:layout_gravity="end"
                android:backgroundTint="@color/btn_login"
                android:contentDescription="@string/retry_failed_message"
                android:minWidth="48dp"
                android:minHeight="48dp"
                android:text="@string/retry_message"
                android:textAllCaps="false"
                android:textColor="@color/white"
                android:textSize="12sp"
                android:visibility="gone" />
        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>
