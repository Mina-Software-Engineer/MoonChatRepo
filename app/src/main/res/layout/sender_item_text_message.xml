<?xml version="1.0" encoding="utf-8"?>
<layout>

        <data>

                <variable
                    name="message"
                    type="com.mina.moonchat.models.TextMessage" />
        </data>

    <androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        xmlns:tools="http://schemas.android.com/tools"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <TextView
            android:id="@+id/text_view_message"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:background="@drawable/send_message_background"
            android:elevation="5dp"
            android:fontFamily="@font/comic_neue_regular"
            android:padding="12dp"
            android:textColor="@color/white"
            android:textSize="15sp"
            android:text="@{message.text}"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintWidth_percent="0.7"
            tools:text="Hi Mina, How are you?" />

        <TextView
            android:id="@+id/text_view_time"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_centerHorizontal="true"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="7dp"
            android:textColor="@color/white"
            android:textSize="11sp"
            app:timeTextConvert="@{message.date}"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/text_view_message"
            tools:text="12:12 Am"
            tools:textColor="@color/gray"/>

    </androidx.constraintlayout.widget.ConstraintLayout>

</layout>