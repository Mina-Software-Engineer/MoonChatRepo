<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>

        <variable
            name="viewmodel"
            type="com.mina.moonchat.viewmodels.ChatViewModel" />
    </data>


    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/chat_background">

        <!-- Top Toolbar / Header -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/toolbar_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#161B22"
            android:paddingStart="8dp"
            android:paddingTop="12dp"
            android:paddingEnd="16dp"
            android:paddingBottom="12dp"
            app:layout_constraintTop_toTopOf="parent">

            <ImageButton
                android:id="@+id/toolbar_back_btn"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/ic_back_button_selector"
                android:contentDescription="Back"
                android:src="@drawable/ic_back_btn"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <!-- Profile Picture -->
            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/chat_pfp_image_view"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginStart="4dp"
                android:scaleType="centerCrop"
                android:transitionName="chat_profile_image_transition"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toEndOf="@id/toolbar_back_btn"
                app:layout_constraintTop_toTopOf="parent"
                app:shapeAppearanceOverlay="@style/CircleImageView"
                tools:src="@drawable/ic_account_circle" />

            <!-- Online Indicator -->
            <View
                android:id="@+id/onlinetv"
                android:layout_width="13dp"
                android:layout_height="13dp"
                android:background="@drawable/online_indicator"
                android:transitionName="chat_online_indicator_transition"
                app:layout_constraintBottom_toBottomOf="@id/chat_pfp_image_view"
                app:layout_constraintEnd_toEndOf="@id/chat_pfp_image_view" />

            <!-- Username -->
            <TextView
                android:id="@+id/toolbar_username"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:fontFamily="sans-serif-medium"
                android:text="@{viewmodel.username}"
                android:textColor="#93C5FD"
                android:textSize="16sp"
                android:textStyle="bold"
                android:transitionName="chat_username_transition"
                app:layout_constraintStart_toEndOf="@+id/chat_pfp_image_view"
                app:layout_constraintTop_toTopOf="parent"
                tools:text="Username" />

            <!-- Status Indicator (Online/Offline/Typing) -->
            <TextView
                android:id="@+id/toolbar_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:text="@{viewmodel.recipientTyping ? &quot;Typing...&quot; : viewmodel.onlineStatus}"
                android:textColor="#9CA3AF"
                android:textSize="12sp"
                app:layout_constraintStart_toEndOf="@+id/chat_pfp_image_view"
                app:layout_constraintTop_toBottomOf="@id/toolbar_username"
                tools:text="Online" />

            <!-- Action Mode Toolbar Overlay -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/action_mode_toolbar_container"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="#161B22"
                android:visibility="gone"
                tools:visibility="visible">

                <ImageButton
                    android:id="@+id/action_mode_close_btn"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="@drawable/ic_back_button_selector"
                    android:contentDescription="@string/unhold_message"
                    android:src="@drawable/ic_back_btn"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <TextView
                    android:id="@+id/action_mode_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:fontFamily="sans-serif-medium"
                    android:text="1"
                    android:textColor="#93C5FD"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toEndOf="@id/action_mode_close_btn"
                    app:layout_constraintTop_toTopOf="parent" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent">

                    <ImageButton
                        android:id="@+id/action_mode_reply_btn"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:layout_marginEnd="4dp"
                        android:background="@drawable/ic_back_button_selector"
                        android:contentDescription="@string/action_reply"
                        android:padding="8dp"
                        android:scaleType="centerInside"
                        android:src="@drawable/ic_reply" />

                    <ImageButton
                        android:id="@+id/action_mode_forward_btn"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:layout_marginEnd="4dp"
                        android:background="@drawable/ic_back_button_selector"
                        android:contentDescription="@string/action_forward"
                        android:padding="8dp"
                        android:scaleType="centerInside"
                        android:src="@drawable/ic_forward" />

                    <ImageButton
                        android:id="@+id/action_mode_copy_btn"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:layout_marginEnd="4dp"
                        android:background="@drawable/ic_back_button_selector"
                        android:contentDescription="@string/action_copy"
                        android:padding="8dp"
                        android:scaleType="centerInside"
                        android:src="@drawable/ic_copy" />

                    <ImageButton
                        android:id="@+id/action_mode_delete_btn"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:background="@drawable/ic_back_button_selector"
                        android:contentDescription="@string/action_delete"
                        android:padding="8dp"
                        android:scaleType="centerInside"
                        android:src="@drawable/ic_delete" />

                </LinearLayout>

            </androidx.constraintlayout.widget.ConstraintLayout>

        </androidx.constraintlayout.widget.ConstraintLayout>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/chat_recycler_view"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:clipToPadding="false"
            android:overScrollMode="ifContentScrolls"
            android:paddingHorizontal="10dp"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:scrollbars="vertical"
            app:layout_constraintBottom_toTopOf="@id/send_message_container"
            app:layout_constraintTop_toBottomOf="@id/toolbar_container"
            tools:listitem="@layout/recipient_item_text_message" />

        <!-- Floating Sticky Date Pill Overlay -->
        <TextView
            android:id="@+id/floating_date_pill"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/date_separator_background"
            android:elevation="6dp"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:paddingHorizontal="14dp"
            android:paddingVertical="6dp"
            android:textColor="@color/text_secondary"
            android:textSize="12sp"
            android:visibility="gone"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/toolbar_container"
            tools:text="Today"
            tools:visibility="visible" />

        <ProgressBar
            android:id="@+id/progressBar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- Bottom Input Area -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/send_message_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#161B22"
            android:paddingVertical="6dp"
            app:layout_constraintBottom_toTopOf="@id/emoji_picker">

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/message_box"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:backgroundTint="#1F2937"
                android:elevation="0dp"
                app:cardCornerRadius="20dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@+id/send_btn"
                app:layout_constraintStart_toEndOf="@id/attach_image_btn"
                app:layout_constraintTop_toTopOf="parent">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/message_input_container"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toStartOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/textView_messageBox"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_toEndOf="@id/emoji_btn"
                        android:background="@drawable/input_background"
                        android:gravity="top|start"
                        android:hint="Type a message..."
                        android:imeOptions="actionGo"
                        android:importantForAutofill="no"
                        android:inputType="textCapSentences|textMultiLine"
                        android:lineSpacingExtra="5dp"
                        android:maxHeight="120dp"
                        android:paddingEnd="8dp"
                        android:maxLines="4"
                        android:paddingVertical="12dp"
                        android:text="@={viewmodel.textMessage}"
                        android:textColor="@color/white"
                        android:textColorHint="@color/gray"
                        android:textSize="17sp"
                        app:layout_constraintBottom_toBottomOf="@+id/emoji_btn"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toEndOf="@+id/emoji_btn"
                        app:layout_constraintTop_toTopOf="@+id/emoji_btn" />

                    <ImageButton
                        android:id="@+id/emoji_btn"
                        android:layout_width="50dp"
                        android:layout_height="50dp"
                        android:background="@drawable/ic_back_button_selector"
                        android:src="@drawable/ic_emoji"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />
                </androidx.constraintlayout.widget.ConstraintLayout>
            </com.google.android.material.card.MaterialCardView>

            <ImageButton
                android:id="@+id/attach_image_btn"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/ic_back_button_selector"
                android:contentDescription="@string/attach_image"
                android:padding="12dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_image_message"
                android:tint="@color/white"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <ImageButton
                android:id="@+id/send_btn"
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:layout_marginEnd="20dp"
                android:background="@drawable/ic_back_button_selector"
                android:focusable="true"
                android:src="@drawable/ic_send"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

        </androidx.constraintlayout.widget.ConstraintLayout>

        <androidx.emoji2.emojipicker.EmojiPickerView
            android:id="@+id/emoji_picker"
            android:layout_width="match_parent"
            android:layout_height="300dp"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>
