<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>

        <variable
            name="viewmodel"
            type="com.mina.moonchat.viewmodels.ChatViewModel" />
    </data>


    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/chat_background">

        <!-- Top Toolbar / Header -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/toolbar_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#161B22"
            android:paddingStart="8dp"
            android:paddingTop="12dp"
            android:paddingEnd="16dp"
            android:paddingBottom="12dp"
            app:layout_constraintTop_toTopOf="parent">

            <ImageButton
                android:id="@+id/toolbar_back_btn"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/ic_back_button_selector"
                android:contentDescription="Back"
                android:src="@drawable/ic_back_btn"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <!-- Profile Picture -->
            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/chat_pfp_image_view"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginStart="4dp"
                android:scaleType="centerCrop"
                android:transitionName="chat_profile_image_transition"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toEndOf="@id/toolbar_back_btn"
                app:layout_constraintTop_toTopOf="parent"
                app:shapeAppearanceOverlay="@style/CircleImageView"
                tools:src="@drawable/ic_account_circle" />

            <!-- Online Indicator -->
            <View
                android:id="@+id/onlinetv"
                android:layout_width="13dp"
                android:layout_height="13dp"
                android:background="@drawable/online_indicator"
                android:transitionName="chat_online_indicator_transition"
                app:layout_constraintBottom_toBottomOf="@id/chat_pfp_image_view"
                app:layout_constraintEnd_toEndOf="@id/chat_pfp_image_view" />

            <!-- Username -->
            <TextView
                android:id="@+id/toolbar_username"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:fontFamily="sans-serif-medium"
                android:text="@{viewmodel.username}"
                android:textColor="#93C5FD"
                android:textSize="16sp"
                android:textStyle="bold"
                android:transitionName="chat_username_transition"
                app:layout_constraintStart_toEndOf="@+id/chat_pfp_image_view"
                app:layout_constraintTop_toTopOf="parent"
                tools:text="Username" />

            <!-- Status Indicator (Online/Offline/Typing) -->
            <TextView
                android:id="@+id/toolbar_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:text="@{viewmodel.recipientTyping ? &quot;Typing...&quot; : viewmodel.onlineStatus}"
                android:textColor="#9CA3AF"
                android:textSize="12sp"
                app:layout_constraintStart_toEndOf="@+id/chat_pfp_image_view"
                app:layout_constraintTop_toBottomOf="@id/toolbar_username"
                tools:text="Online" />

        </androidx.constraintlayout.widget.ConstraintLayout>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/chat_recycler_view"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:clipToPadding="false"
            android:overScrollMode="ifContentScrolls"
            android:paddingHorizontal="10dp"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:scrollbars="vertical"
            app:layout_constraintBottom_toTopOf="@id/send_message_container"
            app:layout_constraintTop_toBottomOf="@id/toolbar_container"
            tools:listitem="@layout/recipient_item_text_message" />

        <ProgressBar
            android:id="@+id/progressBar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- Bottom Input Area -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/send_message_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#161B22"
            android:paddingVertical="8dp"
            app:layout_constraintBottom_toTopOf="@id/emoji_picker">


            <!--         <View
                         android:layout_width="match_parent"
                         android:layout_height="1dp"
                         android:paddingBottom="5dp"
                         android:layout_alignParentTop="true"
                         android:background="@color/darkGray"
                         android:id="@+id/horizontal_line" />-->

            <!--<ImageButton
                android:id="@+id/emoji_btn"
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:background="@drawable/ic_back_button_selector"
                android:src="@drawable/ic_emoji"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />-->


            <com.google.android.material.card.MaterialCardView
                android:id="@+id/message_box"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:backgroundTint="#1F2937"
                android:elevation="0dp"
                app:cardCornerRadius="20dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@+id/send_btn"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/message_input_container"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toStartOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/textView_messageBox"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_toEndOf="@id/emoji_btn"
                        android:background="@drawable/input_background"
                        android:gravity="top|start"
                        android:hint="Type a message..."
                        android:imeOptions="actionGo"
                        android:importantForAutofill="no"
                        android:inputType="textCapSentences|textMultiLine"
                        android:lineSpacingExtra="5dp"
                        android:maxHeight="120dp"
                        android:maxLines="4"
                        android:paddingVertical="12dp"
                        android:singleLine="false"
                        android:text="@={viewmodel.textMessage}"
                        android:textColor="@color/white"
                        android:textColorHint="@color/gray"
                        android:textSize="17sp"
                        app:layout_constraintBottom_toBottomOf="@+id/emoji_btn"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toEndOf="@+id/emoji_btn"
                        app:layout_constraintTop_toTopOf="@+id/emoji_btn" />

                    <ImageButton
                        android:id="@+id/emoji_btn"
                        android:layout_width="50dp"
                        android:layout_height="50dp"
                        android:background="@drawable/ic_back_button_selector"
                        android:src="@drawable/ic_emoji"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />
                </androidx.constraintlayout.widget.ConstraintLayout>
            </com.google.android.material.card.MaterialCardView>

            <!--<com.google.android.material.textfield.TextInputEditText
                android:id="@+id/textView_messageBox"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:layout_marginVertical="10dp"
                android:background="@drawable/chat_edit_text_background"
                android:hint="Type a message..."
                android:text="@={viewmodel.textMessage}"
                android:inputType="textCapSentences|textMultiLine"
                android:layout_marginHorizontal="20dp"
                android:textColor="@color/white"
                android:textColorHint="@color/white"
                android:padding="15dp" />-->

            <ImageButton
                android:id="@+id/send_btn"
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:layout_marginEnd="20dp"
                android:background="@drawable/ic_back_button_selector"
                android:focusable="true"
                android:src="@drawable/ic_send"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

        </androidx.constraintlayout.widget.ConstraintLayout>

        <androidx.emoji2.emojipicker.EmojiPickerView
            android:id="@+id/emoji_picker"
            android:layout_width="match_parent"
            android:layout_height="300dp"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>